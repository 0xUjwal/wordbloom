# Postgres connection string. Neon (from the Vercel Marketplace, free plan) works well.
DATABASE_URL=

# Google OAuth 2.0 "Web application" client used for production sign-in.
# Authorized redirect URI: https://<your-domain>/auth/google/callback
# (plus http://localhost:3000/auth/google/callback for local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
